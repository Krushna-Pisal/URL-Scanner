# Optional: enables backend-only Gemini explanations. Leave blank to disable AI.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: when set, authenticated endpoints require this header.
URL_SCANNER_API_KEY=your_scanner_api_key_here
URL_SCANNER_DB_PATH=data/scans.sqlite3
